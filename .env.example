# Never commit your .env copy: it contains a WordPress application password.
WP_BASE_URL=https://wp-domain.com
WP_USERNAME=wordpress-user-with-editor-permissions
WP_APP_PASSWORD=paste-the-application-password-here

# Optional settings
WP_TIMEOUT=30s
WP_MAX_UPLOAD_BYTES=26214400
# Limit files that this MCP process can upload. Point it at the directory where
# post images are generated, for example:
# WP_UPLOAD_ROOT=/srv/wp-content/covers
